baseURL = "https://grassro0t.github.io/"
locale = "zh-CN"
title = "Ro0tRo0m"
theme = "FixIt"
# ---------------------- 网站基础中文优化 ----------------------
defaultContentLanguage = "zh-cn"
hasCJKLanguage = true  # 中日韩字符优化，摘要、分页时间正常
[languages.zh-cn]
dateFormat = "2006‑01‑02"

[outputs]
home = ["HTML", "RSS", "JSON"]

[params]
defaultTheme = "auto"

[params.author]
name = "GrassRo0t"
email = "julian.song.work@outlook.com"
link = "https://github.com/GrassRo0t"

[params.mermaid]
enable = true
theme = "base"
securityLevel = "loose"

# ---------------------- 页面全局配置 ----------------------
[params.page]
toc = true               # 文章目录开启，长技术笔记必备
tocSidebar = true        # 侧边悬浮目录（大屏）
copy = true              # 代码块复制按钮 ✅
ruby = false
fraction = false
# ---------------------- KaTeX数学公式支持 ----------------------
[params.page.math]
enable = true
copyTex = true
mhchem = true
# ---------------------- 内置本地搜索（不需要algolia账号） ----------------------
[params.search]
enable = true
provider = "fuse"
[params.search.fuseOpts]
isCaseSensitive = false
shouldSort = true
location = 0
distance = 1000
threshold = 0.4
minMatchCharLength = 1
limit = 10
keys = ["title", "permalink", "summary", "content"]
# ---------------------- 页脚配置 ----------------------
[params.footer]
enable = true
hugo = false             # 关闭hugo、fixit主题广告输出
copyright = true
author = true
since = "2026"           # 博客起始年份
# ========== 评论系统全局配置 ==========
[params.page.comment]
enable = true          # 全局开启评论；单篇md可以 frontmatter comment: false 关闭
[params.page.comment.giscus]
enable = true
repo = "grassro0t/grassro0t.github.io"          # 替换：用户名/仓库名
repoId = "R_kgDOT4Lznw"             # 替换 giscus网页拿到的repoId
category = "Announcements"      # 推荐 Announcements
categoryId = "DIC_kwDOT4Lzn84DDWxc"     # 替换分类ID
mapping = "title"                # 按文章标题映射discussion，和你papermod保持一致
strict = "0"
reactionsEnabled = "1"          # 开启点赞表情
emitMetadata = "0"
inputPosition = "bottom"        # 评论输入框在下方
lang = "zh‑CN"
lightTheme = "light"
darkTheme = "dark"              # 跟随FixIt明暗主题自动切换
# ---------------------- 不蒜子访问统计（可选，不需要可以注释） ----------------------
[params.busuanzi]
enable = true
siteViews = true
pageViews = true


# ---------------------- 代码高亮增强 ----------------------
[markup.highlight]
codeFences = true
noClasses = false
lineNos = true          # 默认显示代码行号

[[menu.main]]
name = "首页"
url = "/"
weight = 1
[[menu.main]]
name = "文章"
url = "/posts/"
weight = 2
[[menu.main]]
name = "归档"
url = "/archives/"
weight = 3
[[menu.main]]
name = "关于"
url = "/about/"
weight = 4